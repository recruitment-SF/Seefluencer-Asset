# Copy to .env for local dev, or set these in your VPS / Dokploy panel.

# HTTP port the app listens on (proxy/Traefik routes to this).
PORT=3000

# Absolute path to the SQLite database file.
# Local dev: ./data/app.db   |   Docker/Dokploy: /data/app.db (mounted volume)
DB_PATH=./data/app.db

# Secret used to sign the session cookie. MUST be set to a long random value
# in production, otherwise sessions reset on every restart.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change-me-to-a-long-random-string

# Seeded login account (created once, on first run against an empty database).
# CHANGE THESE before deploying for real.
AUTH_SEED_EMAIL=admin@seefluencer.com
AUTH_SEED_PASSWORD=seefluencer

# production enables the Secure cookie flag (requires the TLS proxy in front).
NODE_ENV=development
