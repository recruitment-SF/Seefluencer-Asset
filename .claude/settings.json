{
  "enabledPlugins": {
    "compound-engineering@compound-engineering-plugin": true,
    "github@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat memory/MEMORY.md 2>/dev/null || true",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
